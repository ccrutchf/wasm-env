# The driver's entry points (packages/vulkan/icd.c), generated from the
# Vulkan registry (vk.xml) by build.sh:
#
#   awk -v extensions="VK_KHR_surface ..." -v commands="vkEnumerateInstanceVersion" \
#       -v omit="vkCreateWaylandSurfaceKHR ..." -v implemented="CreateInstance ..." \
#       -f entries.awk vk.xml >entries.h
#
# Every command of Vulkan 1.0, of the extensions named, and the commands
# named goes in one of three tables (global, instance, device: by its
# first parameter's type), but those omitted (the loader's own).
# A command the driver implements (a function named as the command without
# its "vk", or as the command it's an alias of) is checked against
# Vulkan's PFN_ type for it; any other is a stub with the command's own
# parameters, which says once on stderr that it isn't implemented and
# returns VK_ERROR_FEATURE_NOT_PRESENT (or nothing, or zero).

function attr(line, name,    m) {
    if (match(line, " " name "=\"[^\"]*\"")) {
        m = substr(line, RSTART + length(name) + 3, RLENGTH - length(name) - 4)
        return m
    }
    return ""
}

# Whether an api attribute (empty: every API) includes Vulkan itself.
function for_vulkan(api) {
    return api == "" || ("," api ",") ~ /,vulkan,/
}

function untag(s) {
    gsub(/<[^>]*>/, "", s)
    gsub(/^[ \t]+|[ \t]+$/, "", s)
    return s
}

BEGIN {
    n = split(extensions, list, " ")
    for (k = 1; k <= n; k++)
        wanted_ext[list[k]] = 1
    n = split(commands, list, " ")
    for (k = 1; k <= n; k++) {
        listed[list[k]] = 1
        order[++ncmds] = list[k]
    }
    n = split(omit, list, " ")
    for (k = 1; k <= n; k++)
        omitted[list[k]] = 1
    n = split(implemented, list, " ")
    for (k = 1; k <= n; k++)
        have[list[k]] = 1
}

# Commands: aliases, and definitions (their return type and parameters).
/<command [^>]*alias=/ {
    alias[attr($0, "name")] = attr($0, "alias")
    next
}
/<command[ >]/ && !/\/>/ {
    in_cmd = for_vulkan(attr($0, "api"))
    cmd = ""
    next
}
in_cmd && /<proto>/ {
    match($0, /<type>[^<]*<\/type>/)
    t = untag(substr($0, RSTART, RLENGTH))
    match($0, /<name>[^<]*<\/name>/)
    cmd = untag(substr($0, RSTART, RLENGTH))
    ret[cmd] = t
    nparams[cmd] = 0
    next
}
in_cmd && /<param[ >]/ {
    if (!for_vulkan(attr($0, "api")))
        next
    p = $0
    sub(/^[ \t]*<param[^>]*>/, "", p)
    sub(/<\/param>.*/, "", p)
    params[cmd, ++nparams[cmd]] = untag(p)
    if (nparams[cmd] == 1) {
        match(p, /<type>[^<]*<\/type>/)
        first[cmd] = untag(substr(p, RSTART, RLENGTH))
    }
    next
}
/<\/command>/ {
    in_cmd = 0
    next
}

# Vulkan 1.0's commands, and those of the extensions wanted (not those
# that also need a later version or another extension).
/<feature / {
    in_set = for_vulkan(attr($0, "api")) && attr($0, "number") == "1.0"
    next
}
/<\/feature>/ {
    in_set = 0
    next
}
/<extension / {
    in_set = attr($0, "name") in wanted_ext
    next
}
/<\/extension>/ {
    in_set = 0
    next
}
/<require/ {
    in_require = in_set && attr($0, "depends") == "" && for_vulkan(attr($0, "api"))
    next
}
/<\/require>/ {
    in_require = 0
    next
}
/<remove/ {
    in_require = 0
    next
}
in_require && /<command name=/ {
    name = attr($0, "name")
    if (!(name in listed) && !(name in omitted)) {
        listed[name] = 1
        order[++ncmds] = name
    }
    next
}

function level(def,    t) {
    t = first[def]
    if (t == "VkInstance" || t == "VkPhysicalDevice")
        return "instance"
    if (t == "VkDevice" || t == "VkQueue" || t == "VkCommandBuffer")
        return "device"
    return "global"
}

END {
    print "// Generated by packages/vulkan/entries.awk from vk.xml: don't edit."
    print ""
    stubs = 0
    for (k = 1; k <= ncmds; k++) {
        name = order[k]
        def = name in ret ? name : alias[name]
        if (!(def in ret)) {
            print "entries.awk: no definition of " name > "/dev/stderr"
            exit 1
        }
        short = substr(name, 3)
        if (short in have)
            fn[name] = short
        else if (substr(def, 3) in have)
            fn[name] = substr(def, 3)
        else {
            fn[name] = "Stub_" short
            stubs++
            stubbed = stubbed " " name
            decl = ""
            for (i = 1; i <= nparams[def]; i++)
                decl = decl (i > 1 ? ", " : "") params[def, i]
            if (decl == "")
                decl = "void"
            print "static CALL " ret[def] " CC Stub_" short "(" decl ") {"
            print "    unimplemented(\"" name "\");"
            if (ret[def] == "VkResult")
                print "    return VK_ERROR_FEATURE_NOT_PRESENT;"
            else if (ret[def] != "void") {
                print "    " ret[def] " zero;"
                print "    memset(&zero, 0, sizeof zero);"
                print "    return zero;"
            }
            print "}"
        }
        # (The driver's own functions as Vulkan types them.)
        if (fn[name] !~ /^Stub_/)
            print "_Static_assert(__builtin_types_compatible_p(__typeof__(&" fn[name] "), PFN_" name "), \"" fn[name] " isn't typed as " name "\");"
        table[name] = level(def)
    }
    print ""
    print "// Stubbed (" stubs "):" stubbed
    split("global instance device", levels, " ")
    for (l = 1; l <= 3; l++) {
        print ""
        print "static const struct entry " levels[l] "[] = {"
        for (k = 1; k <= ncmds; k++)
            if (table[order[k]] == levels[l])
                print "    {\"" order[k] "\", (PFN_vkVoidFunction)" fn[order[k]] "},"
        print "};"
    }
}
