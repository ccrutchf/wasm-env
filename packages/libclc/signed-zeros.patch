--- a/clc/lib/generic/math/clc_tanpi.inc
+++ b/clc/lib/generic/math/clc_tanpi.inc
@@ -57,6 +57,9 @@
 
   jr = r == 0.5f ? xodd | 0x7f800000 : jr;
 
+  // Integers: a zero of x's sign, the other sign for odd ones (OpenCL).
+  jr = r == 0.0f ? xodd : jr;
+
   ir = ix < 0x4b000000 ? jr : ir;
 
   return __CLC_AS_GENTYPE(ir);
