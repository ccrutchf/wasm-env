--- a/clc/lib/generic/math/clc_cospi.inc
+++ b/clc/lib/generic/math/clc_cospi.inc
@@ -50,6 +50,9 @@
   __clc_sincos_piby4(a * M_PI_F, &sinval, &cosval);
   __CLC_INTN jr = s ^ __CLC_AS_INTN(e != 0 ? cosval : sinval);
 
+  // Odd multiples of 0.5: +0 (OpenCL).
+  jr = r == 0.5f ? 0 : jr;
+
   ir = ix < 0x4b000000 ? jr : ir;
 
   return __CLC_AS_GENTYPE(ir);
--- a/clc/lib/generic/math/clc_sinpi.inc
+++ b/clc/lib/generic/math/clc_sinpi.inc
@@ -48,6 +48,9 @@
   __clc_sincos_piby4(a * M_PI_F, &sinval, &cosval);
   __CLC_INTN jr = xodd ^ __CLC_AS_INTN(e != 0 ? cosval : sinval);
 
+  // Integers: a zero of x's sign (OpenCL; sin(0) is +0).
