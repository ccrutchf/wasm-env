// tests/arm64/vulkan.c's texel buffer: 256 RGBA8 texels read through a
// samplerBuffer (a uniform texel buffer, as vkQuake's palette), packed
// back into words.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform samplerBuffer palette;
layout(set = 0, binding = 1) buffer Out { uint o[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < 256)
        o[i] = packUnorm4x8(texelFetch(palette, int(i)));
}
