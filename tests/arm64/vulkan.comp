// tests/arm64/vulkan.c's compute shader: out = in * scale + add, from a
// read-only buffer, a uniform and push constants, in two descriptor sets.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer In { uint a[]; };
layout(set = 0, binding = 1) buffer Out { uint b[]; };
layout(set = 1, binding = 0) uniform U { uint add; };
layout(push_constant) uniform P { uint scale; uint n; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < n)
        b[i] = a[i] * scale + add;
}
