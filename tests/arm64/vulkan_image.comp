// tests/arm64/vulkan.c's image shader: a combined image sampler read two
// ways (texelFetch, and texture() through a nearest sampler at texel
// centers: the same texels), into a storage image (swizzled) and a buffer.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;
layout(set = 0, binding = 2) buffer Fetched { uint fetched[]; };
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec4 sampled = texture(tex, (vec2(p) + 0.5) / 16.0);
    imageStore(dst, p, sampled.bgra);
    fetched[p.y * 16 + p.x] = packUnorm4x8(texelFetch(tex, p, 0));
}
